rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for authentication & ownership verification
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(ownerId) {
      return isAuthenticated() && request.auth.uid == ownerId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email in ['admin@bizpilot.in', 'manikandan@bizpilot.in', 'admin@test.in'] ||
        (request.auth.token.keys().hasAll(['admin']) && request.auth.token.admin == true)
      );
    }

    // MSME Organization documents
    // Strict isolation: Users can only read, write, and update their own organization
    // Admins can read, list, update, and manage all organizations
    match /organizations/{organizationId} {
      // Read allowed if the user is the owner OR an administrator
      allow read: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid ||
        resource.data.organization.ownerId == request.auth.uid ||
        isAdmin()
      );

      // Create allowed if:
      // 1. Authenticated user designates themselves as owner, AND
      // 2. Normal users cannot initialize with an active subscription (must be pending_payment)
      allow create: if isAuthenticated() && (
        isAdmin() ||
        (
          (request.resource.data.ownerId == request.auth.uid || request.resource.data.organization.ownerId == request.auth.uid) &&
          (
            request.resource.data.accessStatus == 'pending_payment' || 
            request.resource.data.organization.accessStatus == 'pending_payment' ||
            request.resource.data.subscription.status == 'pending' ||
            request.resource.data.organization.subscription.status == 'pending'
          )
        )
      );

      // Update allowed:
      // Admins have full update rights.
      // Normal owners can update, but CANNOT modify sensitive fields:
      // - accountStatus
      // - ownerId
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (
          (resource.data.ownerId == request.auth.uid || resource.data.organization.ownerId == request.auth.uid) &&
          request.resource.data.ownerId == resource.data.ownerId &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['accountStatus', 'ownerId'])
        )
      );

      allow delete: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid ||
        resource.data.organization.ownerId == request.auth.uid ||
        isAdmin()
      );
    }

    // User-scoped onboarding drafts
    match /onboardingDrafts/{userId} {
      allow read, write: if isOwner(userId);
    }

    // User accounts & Profiles
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) || isAdmin();
      allow update: if (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isAdmin'])) || isAdmin();
      allow delete: if isAdmin();

      // Subcollection for verified payment transactions
      match /payments/{paymentId} {
        allow read: if isOwner(userId) || isAdmin();
        // Payment writes restricted to authenticated user for their own records or admin
        allow create, update: if isOwner(userId) || isAdmin();
        allow delete: if isAdmin();
      }
    }

    // Default deny all other unspecified documents
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
